# Bungie API key — used by lib/destiny.ts to fetch the raid status.
# Create one at https://www.bungie.net/en/Application
# Without it, the Destiny widget shows a plain fallback label (site still works).
BUNGIE_API_KEY=

# Not used by the code today (the data layer uses the API key directly, no OAuth flow),
# kept here for reference in case an OAuth flow is added later.
# BUNGIE_OAUTH_CLIENT_ID=
